# Global Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate-a-secure-secret-key-for-django-and-fastapi-services

# Web Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001/api/v1

# Backend API (Django)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
POSTGRES_DB=academia_industry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password_here@postgres:5432/academia_industry_db

# Cache & Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Service (FastAPI)
AI_SERVICE_PORT=8001
OPENAI_API_KEY=sk-placeholder-for-ai-models
ANTHROPIC_API_KEY=sk-ant-placeholder
EMBEDDING_MODEL=text-embedding-3-small

# Storage (S3 / MinIO Compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=portal-documents
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# Authentication (JWT)
JWT_SECRET_KEY=super-secret-jwt-signing-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email & Notifications (SMTP / Twilio / WhatsApp)
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@mg.example.com
EMAIL_HOST_PASSWORD=smtp_password
DEFAULT_FROM_EMAIL=noreply@acad-ind-portal.org
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_API_KEY=
